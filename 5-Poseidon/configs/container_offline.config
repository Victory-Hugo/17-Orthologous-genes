# 离线环境配置
# 此配置禁用远程镜像拉取，只使用本地已导入的镜像

process {   
    withLabel: translatorx  { 
        container = 'nanozoo/translatorx:1.1--1f1af23'
        containerOptions = '--pull=never'  # 禁止尝试从网络拉取
    } 
    withLabel: bioruby      { 
        container = 'nanozoo/bioruby:2.0.1--1f8a188'
        containerOptions = '--pull=never'
    }
    withLabel: tex          { 
        container = 'nanozoo/texlive-core:3.14159265--bb5506c'
        containerOptions = '--pull=never'
    }
    withLabel: raxml        { 
        container = 'nanozoo/raxml:8.2.12--27d10cf'
        containerOptions = '--pull=never'
    }
    withLabel: newick_utils { 
        container = 'nanozoo/newick_utils:1.6--014d613'
        containerOptions = '--pull=never'
    }
    withLabel: hyphy        { 
        container = 'nanozoo/hyphy:2.5.14--ed56f29'
        containerOptions = '--pull=never'
    }
    withLabel: gard         { 
        container = 'nanozoo/hyphy:2.2.7--9dc0fe5'
        containerOptions = '--pull=never'
    }
    withLabel: codeml       { 
        container = 'nanozoo/paml:4.9--cff12e2'
        containerOptions = '--pull=never'
    }
}
